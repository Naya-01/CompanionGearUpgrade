<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>

        <Widget Id="EquipmentConfigModal" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsWindowOpen">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55" />

            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="960" SuggestedHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="StdAssets\Popup\canvas">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="28" MarginRight="28" MarginTop="24" MarginBottom="24" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="Equipment configuration by class" HorizontalAlignment="Center" Brush="Popup.Title.Text" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" MarginBottom="18" Text="Choose an example loadout for each troop class." HorizontalAlignment="Center" />

                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" DataSource="{ClassConfigurations}">
                      <ItemTemplate>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="112" MarginTop="3" MarginBottom="3">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@ClassName" Brush="Clan.TabControl.Text" />

                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <Children>
                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="135" Text="Primary weapon" VerticalAlignment="Center" />

                                <DropdownWidget Id="WeaponDropdown" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="38" ListPanel="WeaponList" Button="WeaponButton" TextWidget="WeaponButton\WeaponText" CurrentSelectedIndex="@SelectedWeaponIndex">
                                  <Children>
                                    <ButtonWidget Id="WeaponButton" ButtonType="Toggle" DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPClan.RoleSelection.Dropdown">
                                      <Children>
                                        <RichTextWidget Id="WeaponText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="SPOptions.Dropdown.Center.Text" Text="@SelectedWeapon" />
                                      </Children>
                                    </ButtonWidget>
                                    <ListPanel Id="WeaponList" DataSource="{WeaponOptions}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="220" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#100404FF" IsVisible="false" StackLayout.LayoutMethod="VerticalTopToBottom" UpdateChildrenStates="true">
                                      <ItemTemplate>
                                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" ButtonType="Radio">
                                          <Children>
                                            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" Brush="Standard.DropdownItem" />
                                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="SPOptions.Dropdown.Item.Text" Text="@StringItem" />
                                          </Children>
                                        </ButtonWidget>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </DropdownWidget>

                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="75" MarginLeft="16" Text="Shield" VerticalAlignment="Center" />
                                <ButtonWidget Id="ShieldButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="38" SuggestedHeight="38" MarginRight="16" ButtonType="Toggle" IsSelected="@UseShield" ToggleIndicator="ShieldIndicator" UpdateChildrenStates="true" Brush="SPOptions.Checkbox.Empty.Button" VerticalAlignment="Center" DoNotPassEventsToChildren="true">
                                  <Children>
                                    <BrushWidget Id="ShieldIndicator" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPOptions.Checkbox.Full.Button" />
                                  </Children>
                                </ButtonWidget>

                                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="55" Text="Armor" VerticalAlignment="Center" />

                                <DropdownWidget Id="ArmorDropdown" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="38" ListPanel="ArmorList" Button="ArmorButton" TextWidget="ArmorButton\ArmorText" CurrentSelectedIndex="@SelectedArmorIndex">
                                  <Children>
                                    <ButtonWidget Id="ArmorButton" ButtonType="Toggle" DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="SPClan.RoleSelection.Dropdown">
                                      <Children>
                                        <RichTextWidget Id="ArmorText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="SPOptions.Dropdown.Center.Text" Text="@SelectedArmor" />
                                      </Children>
                                    </ButtonWidget>
                                    <ListPanel Id="ArmorList" DataSource="{ArmorOptions}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="220" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#100404FF" IsVisible="false" StackLayout.LayoutMethod="VerticalTopToBottom" UpdateChildrenStates="true">
                                      <ItemTemplate>
                                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" ButtonType="Radio">
                                          <Children>
                                            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" Brush="Standard.DropdownItem" />
                                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="SPOptions.Dropdown.Item.Text" Text="@StringItem" />
                                          </Children>
                                        </ButtonWidget>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </DropdownWidget>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>

                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="14" MarginBottom="10" Text="@StatusText" HorizontalAlignment="Center" />

                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="45" Brush="ButtonBrush1" Command.Click="ExecuteSave" DoNotPassEventsToChildren="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Save" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Children>
                        </ButtonWidget>
                        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="45" MarginLeft="16" Brush="ButtonBrush1" Command.Click="ExecuteClose" DoNotPassEventsToChildren="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Close" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
