<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsWindowOpen">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.60" />

        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MaxWidth="1500" MaxHeight="900" MarginLeft="24" MarginRight="24" MarginTop="24" MarginBottom="24" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="StdAssets\Popup\canvas">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="28" MarginRight="28" MarginTop="24" MarginBottom="92" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="@WindowTitle" HorizontalAlignment="Center" Brush="Popup.Title.Text" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="6" MarginBottom="12" Text="@Breadcrumb" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" />

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsRoleSelectionVisible">
                  <Children>
                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipRect="RoleClip" InnerPanel="RoleClip\RoleList" VerticalScrollbar="RoleScrollbar" AutoHideScrollBars="true">
                      <Children>
                        <Widget Id="RoleClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="RoleList" DataSource="{RoleOptions}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58" MarginTop="4" MarginBottom="4" Brush="ButtonBrush1" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@Name" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                        <ScrollbarWidget Id="RoleScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="RoleScrollbarHandle" MaxValue="100" MinValue="0"><Children><ImageWidget Id="RoleScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="24" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" /></Children></ScrollbarWidget>
                      </Children>
                    </ScrollablePanel>
                  </Children>
                </Widget>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsTierSelectionVisible">
                  <Children><ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DataSource="{TierOptions}" StackLayout.LayoutMethod="VerticalTopToBottom"><ItemTemplate><ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58" MarginTop="4" MarginBottom="4" Brush="ButtonBrush1" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@Name" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget></ItemTemplate></ListPanel></Children>
                </Widget>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsCategorySelectionVisible">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" Text="@CurrentTierCostText" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" />
                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="52" HorizontalAlignment="Center" MarginTop="6" MarginBottom="8" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="240" SuggestedHeight="44" Brush="ButtonBrush1" Command.Click="ExecuteResetTierToDefault" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Reset this tier to default" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="44" MarginLeft="12" Brush="ButtonBrush1" Command.Click="ExecuteSetTierPrice" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Set price (gold)" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget>
                            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="260" SuggestedHeight="44" MarginLeft="12" Brush="ButtonBrush1" Command.Click="ExecuteCalculateTierPriceFromEquipment" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Calculate from equipment" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget>
                          </Children>
                        </ListPanel>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DataSource="{CategoryOptions}" StackLayout.LayoutMethod="VerticalTopToBottom"><ItemTemplate><ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58" MarginTop="4" MarginBottom="4" Brush="ButtonBrush1" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@Name" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget></ItemTemplate></ListPanel>
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsSlotSelectionVisible">
                  <Children><ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DataSource="{SlotOptions}" StackLayout.LayoutMethod="VerticalTopToBottom"><ItemTemplate><ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" MarginTop="3" MarginBottom="3" Brush="ButtonBrush1" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" Text="@Name" VerticalAlignment="Center" /></Children></ButtonWidget></ItemTemplate></ListPanel></Children>
                </Widget>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsItemSelectionVisible">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="470" MarginRight="14" Sprite="scrollable_field_9">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" MarginRight="12" MarginTop="10" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" Text="Compatible items" Brush="Clan.TabControl.Text" />
                                <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" MarginTop="4" ClipRect="FilterClip" InnerPanel="FilterClip\FilterList" HorizontalScrollbar="FilterScrollbar" AutoHideScrollBars="true" OnlyAcceptScrollEventIfCanScroll="true">
                                  <Children>
                                    <Widget Id="FilterClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true"><Children><ListPanel Id="FilterList" DataSource="{FilterOptions}" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight"><ItemTemplate><ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="104" SuggestedHeight="36" MarginLeft="2" MarginRight="2" MarginTop="4" MarginBottom="4" Brush="ButtonBrush1" ButtonType="Radio" IsSelected="@IsSelected" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@Name" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget></ItemTemplate></ListPanel></Children></Widget>
                                    <ScrollbarWidget Id="FilterScrollbar" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="5" VerticalAlignment="Bottom" AlignmentAxis="Horizontal" Handle="FilterScrollbarHandle" MaxValue="100" MinValue="0"><Children><ImageWidget Id="FilterScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="5" VerticalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" /></Children></ScrollbarWidget>
                                  </Children>
                                </ScrollablePanel>
                                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" MarginTop="4" Brush="SaveLoad.Search.Button"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="8" MarginBottom="8" MarginLeft="10" MarginRight="10" Brush="SaveLoad.Search.InputText" DefaultSearchText="@SearchPlaceholderText" Text="@ItemSearchText" /></Children></BrushWidget>
                                <ListPanel DataSource="{SortOptions}" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginTop="4" StackLayout.LayoutMethod="HorizontalLeftToRight"><ItemTemplate><ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="170" SuggestedHeight="32" MarginRight="4" Brush="ButtonBrush1" ButtonType="Radio" IsSelected="@IsSelected" Command.Click="ExecuteSelect" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@Name" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget></ItemTemplate></ListPanel>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginTop="4" Text="@ItemCountText" HorizontalAlignment="Right" Brush="Clan.TabControl.Text" />
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                                  <Children>
                                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipRect="ItemClip" InnerPanel="ItemClip\ItemList" VerticalScrollbar="ItemScrollbar" AutoHideScrollBars="true">
                                      <Children>
                                        <Widget Id="ItemClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true"><Children><ListPanel Id="ItemList" DataSource="{ItemOptions}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom"><ItemTemplate><ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="66" MarginTop="2" MarginBottom="2" Brush="ButtonBrush1" ButtonType="Radio" IsSelected="@IsSelected" Command.Click="ExecuteHighlight" Command.HoverBegin="ExecuteHoverBegin" Command.HoverEnd="ExecuteHoverEnd" DoNotPassEventsToChildren="true"><Children><ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="56" MarginLeft="8" HorizontalAlignment="Left" VerticalAlignment="Center" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" IsDisabled="true" /><ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="92" MarginRight="10" StackLayout.LayoutMethod="VerticalTopToBottom"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" Text="@ItemName" VerticalAlignment="Bottom" /><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" Text="@ItemId" VerticalAlignment="Top" Brush="Clan.TabControl.Text" /></Children></ListPanel></Children></ButtonWidget></ItemTemplate></ListPanel></Children></Widget>
                                        <ScrollbarWidget Id="ItemScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="ItemScrollbarHandle" MaxValue="100" MinValue="0"><Children><ImageWidget Id="ItemScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="24" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" /></Children></ScrollbarWidget>
                                      </Children>
                                    </ScrollablePanel>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@HasVisibleItems" Text="No compatible item matches this filter." HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Children>
                                </Widget>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="425" MarginRight="14" Sprite="scrollable_field_9">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="18" MarginRight="18" MarginTop="16" MarginBottom="74">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Text="3D preview" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MaxWidth="310" MarginTop="4" Text="@CurrentItemDisplayName" HorizontalAlignment="Center" VerticalAlignment="Center" ClipContents="true"><Children><HintWidget DataSource="{CurrentItemNameHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" /></Children></TextWidget>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" MarginTop="3" Text="@CurrentItemStringIdLabel" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" ClipContents="true" />
                                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="10" Brush="Frame1Brush">
                                      <Children>
                                        <InventoryItemPreviewWidget DataSource="{ItemPreview}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ItemTableau="PreviewTableau" IsPreviewOpen="@IsSelected"><Children><ItemTableauWidget Id="PreviewTableau" DataSource="{ItemTableau}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="320" SuggestedHeight="320" HorizontalAlignment="Center" VerticalAlignment="Center" ItemModifierId="@ItemModifierId" StringId="@StringId" BannerCode="@BannerCode" InitialTiltRotation="-1.64" /></Children></InventoryItemPreviewWidget>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@HasPreviewItem" Text="@PreviewStateText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Children>
                                    </BrushWidget>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MaxWidth="310" MarginTop="10" Text="@SelectedCandidateDisplayName" HorizontalAlignment="Center" VerticalAlignment="Center" ClipContents="true"><Children><HintWidget DataSource="{SelectedCandidateNameHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" /></Children></TextWidget>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" MarginTop="2" Text="@SelectedCandidateStringId" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" ClipContents="true" />
                                  </Children>
                                </ListPanel>
                              </Children>
                            </Widget>
                            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="14" StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <Children>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="44" Brush="ButtonBrush1" Command.Click="ExecuteSelectItem" DoNotPassEventsToChildren="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Select" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <HintWidget DataSource="{SelectItemHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsDisabled="true" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="44" MarginLeft="12" Brush="ButtonBrush1" Command.Click="ExecuteRemoveItem" DoNotPassEventsToChildren="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Remove" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <HintWidget DataSource="{RemoveItemHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsDisabled="true" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="scrollable_field_9">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="14" MarginRight="14" MarginTop="16" MarginBottom="12" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Text="Item tooltip" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" Text="Hover an item to inspect it" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" IsHidden="@HasInspectionItem" />
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="8" IsVisible="@HasInspectionItem">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@HasComparison">
                                      <Children>
                                        <ListPanel DataSource="{InspectionTooltip}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" Text="@ItemName" HorizontalAlignment="Center" Brush="InventoryDefaultFontBrush" Brush.FontSize="22" /><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" Text="@ItemStringId" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" /><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="155" SuggestedHeight="81" HorizontalAlignment="Center" MarginTop="6" Sprite="Inventory\portrait_cart"><Children><ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="2" MarginBottom="2" MarginLeft="2" MarginRight="2" ImageId="@Id" TextureProviderName="@TextureProviderName" AdditionalArgs="@AdditionalArgs" /></Children></Widget><InventoryTooltipInnerContent Parameter.PropertiesDataSource="{Properties}" MarginTop="8" /></Children></ListPanel>
                                      </Children>
                                    </Widget>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@HasComparison">
                                      <Children>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                          <Children>
                                            <ListPanel DataSource="{InspectionTooltip}" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="205" MarginRight="3" StackLayout.LayoutMethod="VerticalTopToBottom"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="Hovered / selected" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" /><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" Text="@ItemName" HorizontalAlignment="Center" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" /><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="128" SuggestedHeight="67" HorizontalAlignment="Center" Sprite="Inventory\portrait_cart"><Children><ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="2" MarginBottom="2" MarginLeft="2" MarginRight="2" ImageId="@Id" TextureProviderName="@TextureProviderName" AdditionalArgs="@AdditionalArgs" /></Children></Widget><InventoryTooltipInnerContent Parameter.PropertiesDataSource="{Properties}" MarginTop="6" /></Children></ListPanel>
                                            <ListPanel DataSource="{ConfiguredTooltip}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="3" StackLayout.LayoutMethod="VerticalTopToBottom"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="Configured" HorizontalAlignment="Center" Brush="Clan.TabControl.Text" /><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" Text="@ItemName" HorizontalAlignment="Center" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" /><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="128" SuggestedHeight="67" HorizontalAlignment="Center" Sprite="Inventory\portrait_cart"><Children><ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="2" MarginBottom="2" MarginLeft="2" MarginRight="2" ImageId="@Id" TextureProviderName="@TextureProviderName" AdditionalArgs="@AdditionalArgs" /></Children></Widget><InventoryTooltipInnerContent Parameter.PropertiesDataSource="{Properties}" MarginTop="6" /></Children></ListPanel>
                                          </Children>
                                        </ListPanel>
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginTop="8" Text="@StatusText" HorizontalAlignment="Center" ClipContents="true" />
              </Children>
            </ListPanel>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="54" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="22" StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="44" Brush="ButtonBrush1" Command.Click="ExecuteBack" DoNotPassEventsToChildren="true"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Back" HorizontalAlignment="Center" VerticalAlignment="Center" /></Children></ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="44" MarginLeft="12" Brush="ButtonBrush1" Command.Click="ExecuteSave" DoNotPassEventsToChildren="true" IsVisible="@IsTierEditorMainVisible"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Save" HorizontalAlignment="Center" VerticalAlignment="Center" /><HintWidget DataSource="{SaveHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsDisabled="true" /></Children></ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="44" MarginLeft="12" Brush="ButtonBrush1" Command.Click="ExecuteCancel" DoNotPassEventsToChildren="true" IsVisible="@IsTierEditorMainVisible"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Cancel" HorizontalAlignment="Center" VerticalAlignment="Center" /><HintWidget DataSource="{CancelHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsDisabled="true" /></Children></ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
